; I2C controller with clock stretching, repeated START and read-back.
; SDA = uio0, SCL = uio1, both open-drain (writing 1 releases the line).
;
; Host command word (MSB first):
;   [31] START before byte, [30:23] byte, [22] ACK bit to send, [21] STOP after
; Writes send ack=1 (release so the target can ACK). Reads send byte=0xFF and
; ack=0 (ACK) or 1 (NAK). Every byte returns a 9-bit RX word {sampled byte,
; sampled ACK}; the sampled byte doubles as an arbitration read-back.
;
; One SM tick is about a quarter of a bit time: pick clkdiv so a tick is
; >= 0.6 us for 100 kHz or >= 0.16 us for 400 kHz.
.program i2c_master
.side_set 1
.config side_base 1         ; SCL
.config out_base 0          ; SDA
.config out_count 1
.config set_base 0
.config set_count 1
.config in_base 0           ; pin 0 = SDA, pin 1 = SCL
.config pindirs 0b11
.config pins 0b11
.config od 0b11
.config out_shift left
.config in_shift left

idle:
    pull block           side 1       ; bus free, SCL released
    out null, 1          side 1       ; first command always STARTs
start:
    set pins, 0          side 1 [7]   ; START: SDA falls while SCL high
byte:
    set x, 8             side 0       ; 8 data bits + ACK
low:
    nop                  side 0 [3]   ; SCL low, hold time
bit:
    out pins, 1          side 0 [3]   ; SDA changes mid low phase
    nop                  side 1 [1]   ; release SCL
    wait 1 pin 1         side 1       ; clock stretching
high:
    in pins, 1           side 1 [3]   ; sample SDA
    jmp x--, low         side 1 [1]
    nop                  side 0 [3]   ; SCL low after ACK clock
    set pins, 1          side 0       ; release SDA
    push block           side 0
    out y, 1             side 0       ; STOP flag
    jmp !y, busy         side 0
stop:
    set pins, 0          side 0 [3]   ; SDA low
    nop                  side 1 [1]   ; release SCL
    wait 1 pin 1         side 1
    nop                  side 1 [7]   ; tSU;STO
    set pins, 1          side 1 [7]   ; STOP, then bus free time
    jmp idle             side 1
busy:
    pull block           side 0       ; hold SCL low between bytes
    out y, 1             side 0       ; START flag
    jmp !y, byte         side 0
    nop                  side 1 [3]   ; repeated START: release SCL
    wait 1 pin 1         side 1
    jmp start            side 1 [7]   ; tSU;STA

.assert_cycles start byte 8
.assert_cycles low bit 4

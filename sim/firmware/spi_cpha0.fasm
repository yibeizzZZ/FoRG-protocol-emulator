; SPI controller, CPHA=0 (modes 0 and 2), MSB first, full duplex.
; Assemble with CPOL=0 or CPOL=1. 4 SM ticks per bit.
; Host protocol: push (nbits - 1), then data words MSB-aligned. Each received
; byte is pushed to the RX FIFO (low 8 bits).
.program spi_cpha0
.define CPOL 0
.side_set 1
.config side_base 8         ; SCK  uo0
.config out_base 9          ; MOSI uo1
.config out_count 1
.config set_base 10         ; CS_n uo2
.config set_count 1
.config in_base 20          ; MISO ui4
.config sync_bypass 1 << 20
.config pins 0x400 | (CPOL << 8)
.config out_shift left
.config in_shift left
.config autopull 1
.config pull_thresh 32
.config autopush 1
.config push_thresh 8

.wrap_target
idle:
    out x, 32           side CPOL       ; transfer length in bits - 1
    set pins, 0         side CPOL [1]   ; assert CS
bit:
    out pins, 1         side CPOL [1]   ; MOSI changes, SCK idle level
    in pins, 1          side 1-CPOL     ; leading edge: sample MISO
    jmp x--, bit        side 1-CPOL
done:
    ctl flush           side CPOL [1]   ; drop unused bits of the last word
    set pins, 1         side CPOL [1]   ; deassert CS
.wrap

.assert_cycles bit bit|done 4
